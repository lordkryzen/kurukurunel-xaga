			clocks = <0x12 0x00 0x12 0x01 0x12 0x02 0x12 0x03 0x12 0x04 0x12 0x05 0x12 0x06>;
			power-domains = <0x04 0x17>;
		};

		disable-unused-clk-vdec_gcon_base {
