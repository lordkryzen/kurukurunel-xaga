		compatible = "mediatek,tinysys_mbox";
		reg = <0x00 0x1c351000 0x00 0x1000 0x00 0x1c361000 0x00 0x1000>;
		shmem = <0x3d 0x3e>;
		interrupts = <0x00 0x123 0x04 0x00 0x00 0x124 0x04 0x00>;
		#mbox-cells = <0x01>;
		phandle = <0x3c>;
	};

	spmi: spmi@1c804000 {
		compatible = "mediatek,mt6895-spmi";
		reg = <0x00 0x1c804000 0x00 0x8ff 0x00 0x1c801000 0x00 0x100>;
		reg-names = "pmif", "spmimst";
		interrupts-extended = <0x4a 0xf3 0x04 0x01 0x00 0x19e 0x04 0x00>;
		interrupt-names = "rcs_irq", "pmif_irq";
		interrupt-controller;
		#interrupt-cells = <0x01>;
		irq_event_en = <0x80000000 0x00 0x00 0x00 0x00>;
		clocks = <0x4b 0x01 0x4b 0x04 0x4b 0x03>;
		clock-names = "vlp_pmif_clk_mux", "vlp_spmimst_m_clk_mux", "vlp_spmimst_p_clk_mux";
		swinf_ch_start = <0x0a>;
		ap_swinf_no = <0x02>;
		#address-cells = <0x02>;
		#size-cells = <0x00>;
		phandle = <0x6e>;

		main_pmic: pmic@4 {
			compatible = "mediatek,mt6363";
			reg = <0x04 0x00>;
			interrupts = <0x04>;
			#address-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x131>;

			mt6363_dynamic_loading_throttling: mtk_dynamic_loading_throttling {
				compatible = "mediatek,mt6363-dynamic_loading_throttling";
				mediatek,charger = <0x4c>;
				uvlo-level = <0xa28>;
				io-channels = <0x4d 0x02 0x4d 0x03 0x4d 0x00>;
				io-channel-names = "pmic_ptim", "pmic_imix_r", "pmic_batadc";
				bootmode = <0x4e>;
				phandle = <0x163>;
			};

			mtk-spmi-pmic-debug {
				compatible = "mediatek,spmi-pmic-debug";
				cid-addr = <0x63 0x09 0x08>;
			};

			pmic_adc: mt6363-auxadc {
				mediatek,legacy-channel-ids;
				compatible = "mediatek,mt6363-auxadc";
				#io-channel-cells = <0x01>;
				phandle = <0x66>;

				vin3_open {
					pures = <0x00>;
					channel = <0x15>;
				};

				batadc {
					channel = <0x00>;
					resistance-ratio = <0x04 0x01>;
					avg-num = <0x40>;
				};

				bat-temp {
					channel = <0x03>;
					resistance-ratio = <0x03 0x02>;
				};

				chip-temp {
					channel = <0x05>;
				};

				vcore-temp {
					channel = <0x06>;
				};

				vproc-temp {
					channel = <0x07>;
				};

				vgpu-temp {
					channel = <0x08>;
				};

				vtref {
					channel = <0x11>;
					resistance-ratio = <0x03 0x02>;
				};

				vsyssns {
					channel = <0x12>;
					resistance-ratio = <0x03 0x01>;
					avg-num = <0x40>;
				};

				imp {
					channel = <0x0f>;
					resistance-ratio = <0x04 0x01>;
				};

				vin1-100k {
					channel = <0x13>;
