	md_power_throttling: md_power_throttling {
		compatible = "mediatek,md-power-throttling";
		lbat-max-level = <0x03>;
		lbat-reduce-tx-lv1 = <0x06>;
		lbat-reduce-tx-lv2 = <0x06>;
		lbat-reduce-tx-lv3 = <0x06>;
		oc-max-level = <0x02>;
		oc-reduce-tx-lv1 = <0x06>;
		oc-reduce-tx-lv2 = <0x06>;
		soc-max-level = <0x01>;
		soc-reduce-tx-lv1 = <0x00>;
		phandle = <0x2cf>;
	};

	bp_thl: bp_thl {
		compatible = "mediatek,mtk-bp-thl";
		max-throttle-level = <0x02>;
		soc-throttle-level = <0x00 0x01>;
		soc-max-stage = <0x01>;
		soc-limit-threshold = <0x0f>;
		phandle = <0x2d0>;
	};

	peak_power_budget: peak-power-budget@117780 {
		compatible = "mediatek,peak_power_budget";
		status = "disable";
		phandle = <0x2d1>;
	};

	smart_pa: smart_pa {
		status = "okay";
		interrupts = <0x13 0x08>;
		interrupt-parent = <0x4a>;
		phandle = <0x2d2>;
	};

	pd_adapter: pd-adapter {
		compatible = "mediatek,pd_adapter";
		nr-port = <0x01>;
		boot_mode = <0x4e>;
		adapter_name = "pd_adapter";
		force_cv;
		phys = <0x76 0x03>;
		phy-names = "usb2-phy";
		phandle = <0x2d3>;
	};

	flashlight_core: flashlight_core {
		compatible = "mediatek,flashlight_core";
		phandle = <0x2d4>;
	};

	mtk_composite_v4l2_1: mtk_composite_v4l2_1 {
		compatible = "mediatek,mtk_composite_v4l2_1";
		phandle = <0x2d5>;

		port@1 {

			flashlight_1: endpoint {
				phandle = <0x32d>;
				remote-endpoint = <0x32f>;
			};
		};

		port@0 {

			flashlight_0: endpoint {
				phandle = <0x32c>;
				remote-endpoint = <0x32e>;
			};
		};
	};

	mtk_composite_v4l2_2: mtk_composite_v4l2_2 {
		compatible = "mediatek,mtk_composite_v4l2_2";
		phandle = <0x2d6>;

		port@0 {

			main_af_cam0_endpoint: endpoint {
				phandle = <0x351>;
				remote-endpoint = <0x330>;
			};
		};
	};

	mtk_ctd: mtk-ctd {
		compatible = "mediatek,mtk_ctd";
		nr-port = <0x01>;
		chg-name-port0 = "primary_chg";
		bc12-sel-port0 = <0x00>;
		bc12-psy-port0 = <0x78>;
		phandle = <0x2d7>;
	};

