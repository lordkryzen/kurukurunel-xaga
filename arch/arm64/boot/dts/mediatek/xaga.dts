	mt6363_temp: mt6363_temp {
		compatible = "mediatek,mt6363-pmic-temp";
		io-channels = <0x66 0x05 0x66 0x06 0x66 0x07 0x66 0x08>;
		io-channel-names = "pmic6363_ts1", "pmic6363_ts2", "pmic6363_ts3", "pmic6363_ts4";
		#thermal-sensor-cells = <0x01>;
		nvmem-cells = <0x12b>;
		nvmem-cell-names = "mt6363_e_data";
		phandle = <0x128>;
	};

	mt6368_temp: mt6368_temp {
		compatible = "mediatek,mt6368-pmic-temp";
		io-channels = <0x51 0x05 0x51 0x06 0x51 0x07 0x51 0x08>;
		io-channel-names = "pmic6368_ts1", "pmic6368_ts2", "pmic6368_ts3", "pmic6368_ts4";
		#thermal-sensor-cells = <0x01>;
		nvmem-cells = <0x12c>;
		nvmem-cell-names = "mt6368_e_data";
		phandle = <0x129>;
	};

	low_battery_throttling: low-battery-throttling {
		compatible = "mediatek,low_battery_throttling";
		vbat-thd-enable = <0x01>;
		lvsys-thd-enable = <0x00>;
		bat0-thd-volts-l = <0xc4e 0xbb8 0xb54 0xc4e 0xbb8 0xb54 0xc4e 0xbb8 0xb54 0xc4e 0xbb8 0xb54>;
		bat0-thd-volts-h = <0xce4 0xc4e 0xbb8 0xce4 0xc4e 0xbb8 0xce4 0xc4e 0xbb8 0xce4 0xc4e 0xbb8>;
		temperature-max-stage = <0x03>;
		temperature-stage-threshold = <0x19 0x0a 0x00>;
		throttle-level = <0x00 0x01 0x02 0x03 0x00 0x01 0x02 0x03 0x00 0x01 0x02 0x03 0x00 0x01 0x02 0x03>;
		bootmode = <0x4e>;
		gauge = <0x7b>;
		phandle = <0x2ca>;
	};

	pbm: pbm {
		compatible = "mediatek,pbm";
		phandle = <0x2cb>;
	};

	mdpm: mdpm {
		compatible = "mediatek,mt6895-mdpm";
		phandle = <0x2cc>;
	};

	cpu_power_throttling: cpu_power_throttling {
		compatible = "mediatek,cpu-power-throttling";
		lbat-max-level = <0x03>;
		lbat-limit-freq-lv1 = <0xdbba0 0xdbba0 0x13d620>;
		lbat-limit-freq-lv2 = <0xdbba0 0xdbba0 0x13d620>;
		lbat-limit-freq-lv3 = <0xdbba0 0xdbba0 0x13d620>;
		oc-max-level = <0x02>;
		oc-limit-freq-lv1 = <0xdbba0 0xdbba0 0x13d620>;
		oc-limit-freq-lv2 = <0xdbba0 0xdbba0 0x13d620>;
		soc-max-level = <0x01>;
		soc-limit-freq-lv1 = <0x7fffffff 0x7fffffff 0x7fffffff>;
		phandle = <0x2cd>;
	};

	gpu_power_throttling: gpu-power-throttling {
		compatible = "mediatek,gpu-power-throttling";
		lbat-max-level = <0x02>;
		lbat-limit-freq = <0x7fffffff 0x76688>;
		oc-max-level = <0x01>;
		oc-limit-freq = <0x76688>;
		soc-max-level = <0x01>;
		soc-limit-freq = <0x7fffffff>;
		phandle = <0x2ce>;
