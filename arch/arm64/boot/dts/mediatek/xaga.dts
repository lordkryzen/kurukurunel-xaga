	battery_manager: battery-manager {
		compatible = "mediatek,battery manager";
		gauge1 = <0x7b>;
		charger = <0x78>;
		bootmode = <0x4e>;
		phandle = <0x280>;
	};

	lk_charger: lk-charger {
		fast_charge_voltage = <0x2dda48>;
		boot_battery_voltage = <0x36ee80>;
		temp_t1_threshold = <0xfffffff6>;
		temp_t3_threshold = <0x2d>;
		temp_t4_threshold = <0x3c>;
		pre_charger_current = <0x543a8>;
		pd_charger_current = <0x16e360>;
		ta_ac_charger_current = <0x2dc6c0>;
		charging_host_charger_current = <0x16e360>;
		non_std_ac_charger_current = <0x16e360>;
		ac_charger_input_current = <0x1b7740>;
		ac_charger_current = <0x1b7740>;
		usb_charger_current = <0x7a120>;
		compatible = "mediatek,lk_charger";
		enable-anime;
		enable-pd20-reset;
		power-path-support;
		max-charger-voltage = <0x632ea0>;
		fast-charge-voltage = <0x2dc6c0>;
		usb-charger-current = <0x7a120>;
		ac-charger-current = <0x1f47d0>;
		ac-charger-input-current = <0x2dc6c0>;
		non-std-ac-charger-current = <0x7a120>;
		charging-host-charger-current = <0x16e360>;
		ta-ac-charger-current = <0x2dc6c0>;
		pd-charger-current = <0x7a120>;
		temp-t4-threshold = <0x32>;
		temp-t3-threshold = <0x2d>;
		temp-t1-threshold = <0x00>;
		enable-check-vsys;
		phandle = <0x4c>;
	};

	pe: pe {
		compatible = "mediatek,charger,pe";
		gauge = <0x7b>;
		ta_12v_support;
		ta_9v_support;
		pe_ichg_level_threshold = <0xf4240>;
		ta_start_battery_soc = <0x00>;
		ta_stop_battery_soc = <0x55>;
		min_charger_voltage = <0x4630c0>;
		ta_ac_12v_input_current = <0x30d400>;
		ta_ac_9v_input_current = <0x30d400>;
		ta_ac_7v_input_current = <0x30d400>;
		pe_charger_current = <0x2dc6c0>;
		vbat_threshold = <0x1036>;
		phandle = <0x281>;
	};

