	drm_wv: drm_wv {
		compatible = "mediatek,drm_wv";
		status = "okay";
		phandle = <0x2e5>;
	};

	trusty: trusty {
		compatible = "android,trusty-smc-v1";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		tee-id = <0x00>;
		tee-name = "trusty";
		phandle = <0x2e6>;

		trusty_virtio: trusty-virtio {
			compatible = "android,trusty-virtio-v1";
			phandle = <0x147>;
		};

		trusty_irq: trusty-irq {
			compatible = "android,trusty-irq-v1";
			ppi-interrupt-parent = <0x01>;
			phandle = <0x148>;
		};

		tz_system: tz-system {
			compatible = "mediatek,trusty-tz";
			virtio-supply = <0x147>;
			irq-supply = <0x148>;
			phandle = <0x149>;
		};

		mtee {
			compatible = "mediatek,trusty-mtee-v1";
			tz-supply = <0x149>;
			phandle = <0xda>;
		};

		trusty-gz-log {
			compatible = "android,trusty-gz-log-v1";
		};
	};

	nebula_log: nebula-log {
		compatible = "android,nebula-log-v1";
		status = "disabled";
		phandle = <0x2e7>;
	};

	nebula: nebula {
		compatible = "android,nebula-smc-v1";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		tee-id = <0x01>;
		tee-name = "nebula";
		phandle = <0x2e8>;

		nebula-virtio {
			compatible = "android,nebula-virtio-v1";
		};

		nebula-irq {
			compatible = "android,nebula-irq-v1";
			ppi-interrupt-parent = <0x01>;
		};

		nebula-gz-log {
			compatible = "android,nebula-gz-log-v1";
		};
	};

	hypervisor: hypervisor {
		compatible = "mediatek,geniezone-hyp", "mediatek,geniezone";
		status = "disabled";
		phandle = <0x2e9>;
	};

	fingerprint: fingerprint {
		status = "okay";
		interrupts = <0x88 0x01>;
		interrupt-parent = <0x4a>;
		fpc,gpio_irq = <0x4a 0x88 0x00>;
		pinctrl-4 = <0x367>;
		pinctrl-3 = <0x366>;
		pinctrl-2 = <0x365>;
		pinctrl-1 = <0x364>;
		pinctrl-0 = <0x363>;
		pinctrl-names = "default", "reset_high", "reset_low", "eint_init", "spi_cs";
		compatible = "mediatek,fpc1022", "mediatek,goodix-fp";
		phandle = <0x2ea>;
	};

