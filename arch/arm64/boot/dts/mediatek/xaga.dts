	clkchk {
		compatible = "mediatek,mt6895-clkchk";
	};

	pdchk {
		compatible = "mediatek,mt6895-pdchk";
	};

	clocks {

		clk32k: clk32k {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7d00>;
			phandle = <0x14d>;
		};

		clk26m: clk26m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x18cba80>;
			phandle = <0x02>;
		};

		clk13m: clk13m {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0xc65d40>;
			phandle = <0x70>;
		};

		ulposc: ulposc {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0xf7f4900>;
			phandle = <0x14e>;
		};
	};

	atf_logger: atf_logger {
		compatible = "mediatek,tfa_debug";
		phandle = <0x14f>;
	};

	chosen: chosen {
		bootargs_ext = "console=tty0 root=/dev/ram androidboot.hardware=mt6895";
		mkp,policy = <0x1fff5>;
		bootargs = "console=tty0 root=/dev/ram \t\t\trcupdate.rcu_expedited=1 transparent_hugepage=never \t\t\t8250.nr_uarts=2 \t\t\tvmalloc=400M swiotlb=noforce allow_file_spec_access \t\t\tandroid_arch_task_struct_size=512 \t\t\tfirmware_class.path=/vendor/firmware bringup_arg_dt=android_init_v1 androidboot.init_rc=/vendor_dlkm/etc/init.android-headless.rc initcall_debug ignore_loglevel loglevel=8 printk.time=1";
		phandle = <0x4e>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu0: cpu@000 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			enable-method = "psci";
			performance-domains = <0x2a 0x00>;
			clock-frequency = <0x65633340>;
