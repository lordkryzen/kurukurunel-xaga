			compatible = "mediatek,clk-disable-unused";
			clocks = <0x1c 0x00 0x1c 0x01 0x1c 0x02 0x1c 0x03 0x1c 0x04 0x1c 0x05 0x1c 0x06 0x1c 0x07 0x1c 0x08 0x1c 0x09 0x1c 0x0a 0x1c 0x0b 0x1c 0x0c 0x1c 0x0d 0x1c 0x0e 0x1c 0x0f 0x1c 0x10 0x1c 0x11 0x1c 0x12 0x1c 0x13 0x1c 0x14 0x1c 0x15 0x1c 0x16 0x1c 0x17 0x1c 0x18 0x1c 0x19 0x1c 0x1a 0x1c 0x1b 0x1c 0x1c 0x1c 0x1d 0x1c 0x1e 0x1c 0x1f 0x1c 0x20 0x1c 0x21 0x1c 0x22 0x1c 0x23 0x1c 0x24 0x1c 0x25 0x1c 0x26 0x1c 0x27 0x1c 0x28 0x1c 0x29 0x1c 0x2a 0x1c 0x2b 0x1c 0x2c 0x1c 0x2d 0x1c 0x2e 0x1c 0x2f>;
			power-domains = <0x04 0x14>;
		};

		disable-unused-clk-mmsys0 {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x1d 0x00 0x1d 0x01 0x1d 0x02 0x1d 0x03 0x1d 0x04 0x1d 0x05 0x1d 0x06 0x1d 0x07 0x1d 0x08 0x1d 0x09 0x1d 0x0a 0x1d 0x0b 0x1d 0x0c 0x1d 0x0d 0x1d 0x0e 0x1d 0x0f 0x1d 0x10 0x1d 0x11 0x1d 0x12 0x1d 0x13 0x1d 0x14 0x1d 0x15 0x1d 0x16 0x1d 0x17 0x1d 0x18 0x1d 0x19 0x1d 0x1a 0x1d 0x1b 0x1d 0x1c 0x1d 0x1d 0x1d 0x1e 0x1d 0x1f 0x1d 0x20 0x1d 0x21 0x1d 0x22 0x1d 0x23 0x1d 0x24 0x1d 0x25 0x1d 0x26 0x1d 0x27 0x1d 0x28 0x1d 0x29 0x1d 0x2a 0x1d 0x2b 0x1d 0x2c 0x1d 0x2d 0x1d 0x2e 0x1d 0x2f>;
			power-domains = <0x04 0x13>;
		};

		disable-unused-clk-imp_iic_wrap_w {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x1e 0x00>;
		};

		disable-unused-clk-imp_iic_wrap_s {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x1f 0x00 0x1f 0x01 0x1f 0x02 0x1f 0x03 0x1f 0x04 0x1f 0x05 0x1f 0x06>;
		};

		disable-unused-clk-ufs_pdn_cfg {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x20 0x00 0x20 0x01>;
		};

		disable-unused-clk-ufs_ao_config {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x21 0x00 0x21 0x01 0x21 0x02 0x21 0x03 0x21 0x04 0x21 0x05>;
		};

		disable-unused-clk-imp_iic_wrap_c {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x22 0x00 0x22 0x01>;
		};

		disable-unused-clk-pericfg_ao {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x23 0x00 0x23 0x01 0x23 0x02 0x23 0x03 0x23 0x04 0x23 0x05 0x23 0x06 0x23 0x07 0x23 0x08 0x23 0x09 0x23 0x0a 0x23 0x0b 0x23 0x0c 0x23 0x0d 0x23 0x0e 0x23 0x0f 0x23 0x10 0x23 0x11 0x23 0x12 0x23 0x13 0x23 0x14 0x23 0x15 0x23 0x16 0x23 0x17 0x23 0x18 0x23 0x19 0x23 0x1a 0x23 0x1b 0x23 0x1c 0x23 0x1d 0x23 0x1e>;
		};

		disable-unused-clk-infracfg_ao {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x24 0x00 0x24 0x01 0x24 0x02 0x24 0x03 0x24 0x04 0x24 0x05 0x24 0x06 0x24 0x07 0x24 0x08 0x24 0x09 0x24 0x0a 0x24 0x0b 0x24 0x0c 0x24 0x0d>;
		};

		disable-unused-clk-topckgen {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x25 0x58 0x25 0x59 0x25 0x5a 0x25 0x5b 0x25 0x5c 0x25 0x5d 0x25 0x5e 0x25 0x5f 0x25 0x60 0x25 0x61 0x25 0x62 0x25 0x04 0x25 0x05 0x25 0x06 0x25 0x07 0x25 0x08 0x25 0x09 0x25 0x0a 0x25 0x0b 0x25 0x0c 0x25 0x0d 0x25 0x0e 0x25 0x0f 0x25 0x10 0x25 0x11 0x25 0x14 0x25 0x15 0x25 0x16 0x25 0x17 0x25 0x18 0x25 0x19 0x25 0x1a 0x25 0x1b 0x25 0x1c 0x25 0x1d 0x25 0x1e 0x25 0x1f 0x25 0x20 0x25 0x22 0x25 0x23 0x25 0x24 0x25 0x25 0x25 0x26 0x25 0x27 0x25 0x28 0x25 0x29 0x25 0x2a 0x25 0x2b 0x25 0x2c 0x25 0x2d 0x25 0x2f 0x25 0x30 0x25 0x31 0x25 0x32 0x25 0x33 0x25 0x34 0x25 0x35 0x25 0x36 0x25 0x39 0x25 0x3a 0x25 0x3b 0x25 0x3c 0x25 0x43 0x25 0x44 0x25 0x46 0x25 0x47 0x25 0x48 0x25 0x49 0x25 0x4a 0x25 0x4e 0x25 0x4f 0x25 0x50 0x25 0x51 0x25 0x52 0x25 0x53 0x25 0x54 0x25 0x55 0x25 0x56 0x25 0x57>;
		};

		disable-unused-clk-apmixedsys {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x26 0x00 0x26 0x01 0x26 0x02 0x26 0x03 0x26 0x04 0x26 0x05 0x26 0x06 0x26 0x07 0x26 0x08 0x26 0x09 0x26 0x0a 0x26 0x0b 0x26 0x0c 0x26 0x0d>;
		};

		disable-unused-clk-apupll_pll_ctrl {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x27 0x00>;
		};

		disable-unused-clk-npupll_pll_ctrl {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x28 0x00>;
		};

		disable-unused-clk-apupll1_pll_ctrl {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x29 0x00>;
		};
