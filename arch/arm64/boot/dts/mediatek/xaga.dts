			clocks = <0x16 0x00 0x16 0x01>;
			power-domains = <0x04 0x09>;
		};

		disable-unused-clk-ipesys {
			compatible = "mediatek,clk-disable-unused";
			clocks = <0x17 0x00 0x17 0x01 0x17 0x02 0x17 0x03 0x17 0x04>;
