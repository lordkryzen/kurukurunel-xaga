		odm: odm {
			compatible = "simple-bus";
			phandle = <0x26e>;

			simtray {
				status-gpio = <0x4a 0x2a 0x00>;
				compatible = "xiaomi,simtray-status";
			};

			thermal_message: thermal-message {
				phandle = <0x384>;
				board-sensor = "VIRTUAL-SENSOR";
			};

			xiaomi_touch: xiaomi_touch {
				phandle = <0x37c>;
				touch,name = "xiaomi-touch";
				status = "ok";
				compatible = "xiaomi-touch";
			};

			vibrator0: vibrator@0 {
				phandle = <0x37b>;
				vib_vol = <0x09>;
				vib_limit = <0x09>;
				vib_timer = <0x19>;
				compatible = "mediatek,vibrator";
			};

			rt5133_eint: rt5133-eint {
				status = "okay";
				interrupts = <0x8d 0x02>;
				interrupt-parent = <0x4a>;
				phandle = <0x26f>;
			};

			rt5133_gpio1: rt5133-gpio1 {
				compatible = "regulator-fixed";
				regulator-name = "rt5133-gpio1";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				vin-supply = <0x74>;
				enable-active-high;
				gpio = <0x103 0x00 0x00>;
				phandle = <0x270>;
			};

			rt5133_gpio2: rt5133-gpio2 {
				compatible = "regulator-fixed";
				regulator-name = "rt5133-gpio2";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				vin-supply = <0x74>;
				enable-active-high;
				gpio = <0x103 0x01 0x00>;
				phandle = <0x271>;
			};

			rt5133_gpio3: rt5133-gpio3 {
				compatible = "regulator-fixed";
				regulator-name = "rt5133-gpio3";
				regulator-min-microvolt = <0x1b7740>;
				regulator-max-microvolt = <0x1b7740>;
				vin-supply = <0x74>;
				enable-active-high;
				gpio = <0x103 0x02 0x00>;
				phandle = <0x272>;
			};
		};

		ssusb: usb0@11201000 {
			usb-role-switch;
			compatible = "mediatek,mtu3", "mediatek,mt6895-mtu3";
			reg = <0x00 0x11201000 0x00 0x2e00 0x00 0x11203e00 0x00 0x100>;
