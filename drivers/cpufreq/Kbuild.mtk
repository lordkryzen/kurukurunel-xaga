# Generated from pinned Xiaomi targets; per-source flags preserve module boundaries.
LINUXINCLUDE :=  -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi $(LINUXINCLUDE)
obj-m += mediatek-cpufreq-hw.o
mediatek-cpufreq-hw-y := mediatek-cpufreq-hw_main.o mediatek-cpufreq-hw_fdvfs.o
CFLAGS_mediatek-cpufreq-hw_main.o += -I$(XAGA_ROOT)/drivers/cpufreq -iquote$(XAGA_ROOT)/drivers/cpufreq -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi
CFLAGS_mediatek-cpufreq-hw_fdvfs.o += -I$(XAGA_ROOT)/drivers/cpufreq -iquote$(XAGA_ROOT)/drivers/cpufreq -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi
