# Generated from pinned Xiaomi targets; per-source flags preserve module boundaries.
LINUXINCLUDE :=  -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi $(LINUXINCLUDE)
obj-m += spmi-mtk-pmif.o
spmi-mtk-pmif-y := spmi-mtk-pmif-core.o spmi-mtk-debug.o
obj-m += spmi-mtk-mpu.o
CFLAGS_spmi-mtk-pmif-core.o += -I$(XAGA_ROOT)/drivers/spmi -iquote$(XAGA_ROOT)/drivers/spmi -I$(DEVICE_MODULES_PATH)/drivers/misc/mediatek/include/ -I$(XAGA_ROOT)/drivers/spmi/include -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/aed -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump/include -I$(XAGA_ROOT)/drivers/mfd/include
CFLAGS_spmi-mtk-debug.o += -I$(XAGA_ROOT)/drivers/spmi -iquote$(XAGA_ROOT)/drivers/spmi -I$(DEVICE_MODULES_PATH)/drivers/misc/mediatek/include/ -I$(XAGA_ROOT)/drivers/spmi/include -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/aed -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump/include -I$(XAGA_ROOT)/drivers/mfd/include
CFLAGS_spmi-mtk-mpu.o += -I$(XAGA_ROOT)/drivers/spmi -iquote$(XAGA_ROOT)/drivers/spmi -I$(XAGA_ROOT)/drivers/spmi/include -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/aed -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump/include -I$(XAGA_ROOT)/drivers/mfd/include
