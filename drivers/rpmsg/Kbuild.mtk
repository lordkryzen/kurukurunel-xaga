# Generated from pinned Xiaomi targets; per-source flags preserve module boundaries.
LINUXINCLUDE :=  -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi $(LINUXINCLUDE)
obj-m += mtk_rpmsg_mbox.o
CFLAGS_mtk_rpmsg_mbox.o += -I$(XAGA_ROOT)/drivers/rpmsg -iquote$(XAGA_ROOT)/drivers/rpmsg -I$(srctree)/drivers/rpmsg -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi
