# Generated from pinned Xiaomi targets; per-source flags preserve module boundaries.
LINUXINCLUDE :=  -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi $(LINUXINCLUDE)
obj-m += mtk-uart-apdma.o
CFLAGS_mtk-uart-apdma.o += -I$(XAGA_ROOT)/drivers/dma/mediatek -iquote$(XAGA_ROOT)/drivers/dma/mediatek -I$(srctree)/drivers/dma/mediatek -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi -I$(XAGA_ROOT)/drivers/misc/mediatek/sda/include -I$(XAGA_ROOT)/drivers/misc/mediatek/sda
