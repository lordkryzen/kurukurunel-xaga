# Generated from pinned Xiaomi targets; per-source flags preserve module boundaries.
LINUXINCLUDE :=  -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi $(LINUXINCLUDE)
obj-m += mtk-kpd.o
obj-m += mtk-pmic-keys.o
CFLAGS_mtk-kpd.o += -I$(XAGA_ROOT)/drivers/input/keyboard -iquote$(XAGA_ROOT)/drivers/input/keyboard -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi
CFLAGS_mtk-pmic-keys.o += -I$(XAGA_ROOT)/drivers/input/keyboard -iquote$(XAGA_ROOT)/drivers/input/keyboard -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi
