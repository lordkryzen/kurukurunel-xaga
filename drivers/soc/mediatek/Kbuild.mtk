# Generated from pinned Xiaomi targets; per-source flags preserve module boundaries.
LINUXINCLUDE :=  -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi $(LINUXINCLUDE)
obj-m += mtk-mmdvfs-v3.o
obj-m += mtk_tinysys_ipi.o
obj-m += mtk-mmdvfs.o
obj-m += mtk-mbox.o
obj-m += mtk-dvfsrc.o
obj-m += mtk-scpsys.o
obj-m += mtk-scpsys-mt6895.o
obj-m += mtk-pmic-wrap.o
CFLAGS_mtk-mmdvfs-v3.o += -I$(XAGA_ROOT)/drivers/soc/mediatek -iquote$(XAGA_ROOT)/drivers/soc/mediatek -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi -I$(XAGA_ROOT)/drivers/clk/mediatek -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/aed -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump/include -I$(XAGA_ROOT)/drivers/misc/mediatek/mmdebug -I$(XAGA_ROOT)/drivers/misc/mediatek/smi -I$(XAGA_ROOT)/drivers/memory -I$(XAGA_ROOT)/drivers/misc/mediatek/mme -I$(XAGA_ROOT)/drivers/misc/mediatek/mminfra -I$(XAGA_ROOT)/drivers/misc/mediatek/hwccf -I$(XAGA_ROOT)/drivers/misc/mediatek/hwccf/include -I$(XAGA_ROOT)/drivers/misc/mediatek/vcp/rv -I$(XAGA_ROOT)/drivers/misc/mediatek/vcp/include -I$(XAGA_ROOT)/drivers/misc/mediatek/smi/virtio_smi -I$(XAGA_ROOT)/drivers/memory/mediatek -I$(XAGA_ROOT)/drivers/iommu -I$(XAGA_ROOT)/drivers/iommu/arm/arm-smmu-v3 -I$(XAGA_ROOT)/drivers/misc/mediatek/mmp/src -I$(XAGA_ROOT)/drivers/misc/mediatek/mmdvfs
CFLAGS_mtk_tinysys_ipi.o += -I$(XAGA_ROOT)/drivers/soc/mediatek -iquote$(XAGA_ROOT)/drivers/soc/mediatek -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi
CFLAGS_mtk-mmdvfs.o += -I$(XAGA_ROOT)/drivers/soc/mediatek -iquote$(XAGA_ROOT)/drivers/soc/mediatek -I$(DEVICE_MODULES_PATH)/drivers/misc/mediatek/mmp -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi -I$(XAGA_ROOT)/drivers/misc/mediatek/mmp/src -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/aed -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump/include -I$(XAGA_ROOT)/drivers/misc/mediatek/smi -I$(XAGA_ROOT)/drivers/memory -I$(XAGA_ROOT)/drivers/misc/mediatek/mme -I$(XAGA_ROOT)/drivers/clk/mediatek -I$(XAGA_ROOT)/drivers/misc/mediatek/mminfra -I$(XAGA_ROOT)/drivers/misc/mediatek/hwccf -I$(XAGA_ROOT)/drivers/misc/mediatek/hwccf/include -I$(XAGA_ROOT)/drivers/misc/mediatek/vcp/rv -I$(XAGA_ROOT)/drivers/misc/mediatek/vcp/include -I$(XAGA_ROOT)/drivers/misc/mediatek/smi/virtio_smi -I$(XAGA_ROOT)/drivers/memory/mediatek -I$(XAGA_ROOT)/drivers/iommu -I$(XAGA_ROOT)/drivers/iommu/arm/arm-smmu-v3
CFLAGS_mtk-mbox.o += -I$(XAGA_ROOT)/drivers/soc/mediatek -iquote$(XAGA_ROOT)/drivers/soc/mediatek -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi
CFLAGS_mtk-dvfsrc.o += -I$(XAGA_ROOT)/drivers/soc/mediatek -iquote$(XAGA_ROOT)/drivers/soc/mediatek -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi
CFLAGS_mtk-scpsys.o += -I$(XAGA_ROOT)/drivers/soc/mediatek -iquote$(XAGA_ROOT)/drivers/soc/mediatek -I$(DEVICE_MODULES_PATH)/drivers/clk/mediatek/ -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi -I$(XAGA_ROOT)/drivers/clk/mediatek -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/aed -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump/include
CFLAGS_mtk-scpsys-mt6895.o += -I$(XAGA_ROOT)/drivers/soc/mediatek -iquote$(XAGA_ROOT)/drivers/soc/mediatek -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi -I$(XAGA_ROOT)/drivers/clk/mediatek -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/aed -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump/include
CFLAGS_mtk-pmic-wrap.o += -I$(XAGA_ROOT)/drivers/soc/mediatek -iquote$(XAGA_ROOT)/drivers/soc/mediatek -I$(DEVICE_MODULES_PATH)/drivers/misc/mediatek/include/ -I$(DEVICE_MODULES_PATH)/drivers/misc/mediatek/include/mt-plat -I$(XAGA_ROOT)/drivers/soc/mediatek/include -I$(srctree)/include/mediatek -I$(srctree)/include/mediatek/uapi -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/aed -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump -I$(XAGA_ROOT)/drivers/misc/mediatek/aee/mrdump/include
